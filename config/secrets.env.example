# Credentials for the Forgejo-primary / GitHub-mirror setup.
#
# Copy to config/secrets.env and fill in. That file is gitignored — this
# .example is the only one tracked. NEVER put real values in this file.
#
#   cp config/secrets.env.example config/secrets.env
#   chmod 600 config/secrets.env

# Forgejo API token — git.home.snitzer.space -> Settings -> Applications.
# Scopes required: write:repository, write:organization
FORGEJO_TOKEN=

# Forgejo API base. The LAN IP avoids depending on the proxy (CT 102).
FORGEJO_API=http://10.5.1.63:3000/api/v1

# GitHub PAT that Forgejo stores to push the mirror.
# Classic token, scopes: repo, workflow
# (workflow is required or mirrored pushes touching .github/workflows are rejected)
GITHUB_MIRROR_TOKEN=
GITHUB_MIRROR_USER=Snitzer-Family
