{
  "name": "coach-vision",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @coachvision/web",
    "dev:board": "npm run dev -w @coachvision/board",
    "build": "npm run build -w @coachvision/web",
    "build:board": "npm run build -w @coachvision/board",
    "typecheck": "npm run typecheck -w @coachvision/web",
    "test": "node tests/run.mjs",
    "preview:drill": "node packages/drill-core/scripts/build-drill-preview.mjs"
  }
}
